@Article{ChSh25,
  author   = {Gary P.T. Choi and Mahmoud Shaqfa},
  journal  = {J. Comput. Appl. Math.},
  title    = {Hemispheroidal parameterization and harmonic decomposition of simply connected open surfaces},
  year     = {2025},
  issn     = {0377-0427},
  pages    = {116455},
  volume   = {461},
  abstract = {Spectral analysis of open surfaces is gaining momentum for studying surface morphology in engineering, computer graphics, and medical domains. This analysis is enabled using proper parameterization approaches on the target analysis domain. In this paper, we propose the usage of customizable parameterization coordinates that allow mapping open surfaces into oblate or prolate hemispheroidal surfaces. For this, we proposed the usage of Tutte, conformal, area-preserving, and balanced mappings for parameterizing any given simply connected open surface onto an optimal hemispheroid. The hemispheroidal harmonic bases were introduced to spectrally expand open parametric surfaces by generalizing the known hemispherical ones. This approach uses the depth of the hemispheroid as a degree of freedom to control the size of the parameterization domain of the open surfaces while providing numerically stable basis functions. Several open surfaces have been tested using different mapping combinations. We also propose optimization-based mappings to serve various applications on the reconstruction problem. Altogether, our work provides an effective way to represent and analyze simply connected open surfaces.},
  doi      = {https://doi.org/10.1016/j.cam.2024.116455},
  keywords = {Hemispheroidal parameterization, Hemispheroidal harmonics, Shape representation, Harmonic decomposition, Simply connected open surfaces},
  url      = {https://www.sciencedirect.com/science/article/pii/S0377042724007039},
}





@Article{Davi91,
  author   = {Davidon, William C.},
  journal  = {SIAM J. Optim.},
  title    = {Variable Metric Method for Minimization},
  year     = {1991},
  number   = {1},
  pages    = {1-17},
  volume   = {1},
  abstract = {This is a method for determining numerically local minima of differentiable functions of several variables. In the process of locating each minimum, a matrix which characterizes the behavior of the function about the minimum is determined. For a region in which the function depends quadratically on the variables, no more than N iterations are required, where N is the number of variables. By suitable choice of starting values, and without modification of the procedure, linear constraints can be imposed upon the variables.},
  doi      = {10.1137/0801001},
  eprint   = {https://doi.org/10.1137/0801001},
  url      = {https://doi.org/10.1137/0801001},
}

@Article{Broy70,
  author   = {Broyden, C. G.},
  journal  = {IMA Journal of Applied Mathematics},
  title    = {The Convergence of a Class of Double-rank Minimization Algorithms 1. General Considerations},
  year     = {Journal Inst. Math. Applic.},
  issn     = {0272-4960},
  month    = {03},
  number   = {1},
  pages    = {76-90},
  volume   = {6},
  abstract = {This paper presents a more detailed analysis of a class of minimization algorithms, which includes as a special case the DFP (Davidon-Fletcher-Powell) method, than has previously appeared. Only quadratic functions are considered but particular attention is paid to the magnitude of successive errors and their dependence upon the initial matrix. On the basis of this a possible explanation of some of the observed characteristics of the class is tentatively suggested.},
